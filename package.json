{
  "name": "codemap",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "codemap": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "tsc && node --test \"dist/**/*.test.js\" \"web/src/*.test.ts\"",
    "codemap": "node dist/cli/index.js",
    "serve": "node dist/server/main.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@vscode/codicons": "^0.0.46-24",
    "@xyflow/react": "^12.11.5",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.2"
  }
}
