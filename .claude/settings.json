{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "P=\"${CLAUDE_PROJECT_DIR:-.}/.claude/codemap.port\"; [ -f \"$P\" ] && curl -sf -m 2 -X POST \"http://127.0.0.1:$(cat \"$P\")/api/hook\" -H 'content-type: application/json' --data-binary @- 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
